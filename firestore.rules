rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Kullanıcı profilleri — kendi profilini yazar, eşleşme sırasında partner pairingId/partnerId güncelleyebilir
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        // Eşleşme sırasında partner sadece pairingId, partnerId, updatedAt alanlarını güncelleyebilir
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pairingId', 'partnerId', 'updatedAt'])
      );
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Çift bilgileri — eşleşmiş kullanıcılar erişebilir
    match /couples/{coupleId} {
      allow read, write: if request.auth != null;
    }

    // Eşleşmeler
    match /pairings/{pairingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null 
        && (resource.data.user1Id == request.auth.uid || resource.data.user2Id == request.auth.uid);
    }

    // Eşleşme davetleri
    match /pairingInvites/{inviteId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }

    // Planlar — kendi veya paylaşılan
    match /plans/{planId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null;
    }

    // Görevler — kendi veya paylaşılan
    match /todos/{todoId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null;
    }

    // Harcamalar — kendi veya paylaşılan
    match /expenses/{expenseId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null;
    }

    // Günlük ruh hali — kendi veya paylaşılan
    match /moods/{moodId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null;
    }
  }
}
